        <mxCell id="title" value="EEG  |  Source retention, clinical display, and H5 findings" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#10243A;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="1710" height="42" as="geometry" />
        </mxCell>
        <mxCell id="upload" value="1  EEG archive upload&#10;Supported recording formats&#10;Owner-scoped case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="secure-intake">
          <mxGeometry x="30" y="22" width="205" height="110" as="geometry" />
        </mxCell>
        <mxCell id="source-encrypt" value="2  Encrypt before persistence&#10;AES-GCM source archive&#10;Private storage outside PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=14;spacing=10;" vertex="1" parent="secure-intake">
          <mxGeometry x="290" y="22" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="workspace" value="3  Background processing&#10;Owner-only temporary workspace&#10;Plaintext removed after use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#78350F;fontSize=14;spacing=10;" vertex="1" parent="secure-intake">
          <mxGeometry x="565" y="22" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="4  Validate + parse source&#10;Retain channels, timing, gaps&#10;Read source annotations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;fontSize=14;spacing=10;" vertex="1" parent="secure-intake">
          <mxGeometry x="840" y="22" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="branch" value="Separate paths&#10;Original waveform for review&#10;Model tensor for inference" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;strokeWidth=2;fontColor=#713F12;fontSize=14;spacing=9;" vertex="1" parent="1">
          <mxGeometry x="1120" y="240" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="model-input" value="5A  Model-input preparation&#10;Scrub selected identifying metadata&#10;18 reviewed bipolar channels&#10;Resample 256 Hz; model filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;spacing=10;" vertex="1" parent="model-lane">
          <mxGeometry x="50" y="22" width="240" height="145" as="geometry" />
        </mxCell>
        <mxCell id="windows" value="5B  Window tensor&#10;4 seconds · 1,024 samples&#10;2-second stride&#10;float32 (N, 1024, 18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;spacing=9;" vertex="1" parent="model-lane">
          <mxGeometry x="50" y="222" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="h5" value="6  Reviewed H5 adapter&#10;Artifact + contract hash checks&#10;Fail closed on mismatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=13;spacing=8;" vertex="1" parent="model-lane">
          <mxGeometry x="270" y="222" width="185" height="140" as="geometry" />
        </mxCell>
        <mxCell id="scores" value="7  Window findings&#10;Score + threshold + source time&#10;Research output, not diagnosis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=2;fontColor=#7C2D12;fontSize=13;spacing=8;" vertex="1" parent="model-lane">
          <mxGeometry x="270" y="422" width="185" height="140" as="geometry" />
        </mxCell>
        <mxCell id="shap" value="Optional SHAP&#10;Disabled by default&#10;Requires reviewed background" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#475569;fontSize=13;spacing=9;" vertex="1" parent="model-lane">
