        <mxCell id="note" value="Display filtering/scaling is separate from model preprocessing. The viewer does not normalize the original signal to hide amplitude or missing-data problems." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#475569;fontSize=13;spacing=9;" vertex="1" parent="1">
