        </mxCell>
        <mxCell id="retain-waveform" value="5C  Retained review waveform&#10;Full source-derived channels&#10;Acquisition gaps + timestamps&#10;Encrypted outside PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;fontSize=14;spacing=10;" vertex="1" parent="secure-intake">
