# Copy to .env for local Docker development. Never commit real secrets.
# Run node scripts/setup.mjs to generate these values in .env.
POSTGRES_PASSWORD=
MDS01_STORAGE_KEY=
MDS01_TEMPLATE_KEY=
MODEL_RUNTIME=stub
INSTALL_RESEARCH=false
SIGNAL_RETENTION_CONTEXT_SECONDS=600
MAX_UPLOAD_BYTES=2147483648
MAX_ACTIVE_UPLOAD_DRAFTS=2
MAX_PENDING_DRAFT_BYTES=2148532224
CLEANUP_INTERVAL_SECONDS=60
UPLOAD_DRAFT_TTL_SECONDS=1800
ENABLE_SIGNAL_PREVIEW=false
ENABLE_FULL_SIGNAL_PREVIEW=false
FULL_SIGNAL_PREVIEW_MAX_SECONDS=7200
ENABLE_SHAP_EXPLANATIONS=false
SHAP_METADATA_BACKGROUND_PATH=/app/backend/model/shap-background-metadata.npy
SHAP_OBFUSCATED_BACKGROUND_PATH=/app/backend/model/shap-background-obfuscated.npy
SHAP_MAX_WINDOWS=3
SHAP_TIME_BINS=32
MAX_CONCURRENT_ANALYSES=1
MAX_VIDEO_UPLOAD_BYTES=536870912
VIDEO_RETENTION_SECONDS=86400
VIDEO_MAX_DURATION_SECONDS=3600
# The visual model contract requires at least 6 FPS and 1920x1080 input;
# these bounds also cap decoder/output resource use before inference.
VIDEO_MIN_FPS=6
VIDEO_MAX_FPS=60
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1080
VIDEO_MAX_FRAMES=216000
VIDEO_MAX_OUTPUT_BYTES=1073741824
VIDEO_PRIVACY_TIMEOUT_SECONDS=900
VIDEO_PREFLIGHT_TIMEOUT_SECONDS=30
VIDEO_PRIVACY_MAX_ACTIVE_JOBS=4
VIDEO_PRIVACY_MAX_ACTIVE_JOBS_PER_OWNER=1
VIDEO_PRIVACY_MAX_CONCURRENT_JOBS=1
MDS01_MAX_ARCHIVE_TOTAL_BYTES=2147483648
MDS01_MAX_ZIP_COMPRESSION_RATIO=100
MDS01_MAX_ARCHIVE_MEMBER_COUNT=4096
MAX_ARCHIVE_MEMBER_BYTES=2147483648
MAX_EDF_FILES_PER_ARCHIVE=500

# Local development uses MDS01 accounts and Docker binds the API to loopback.
APP_ENV=development
AUTH_MODE=local-accounts
VIDEO_DETECTION_ENABLED=true
DEMO_ADMIN_ENABLED=true
DEMO_ADMIN_EMAIL=admin@mds01.local
# setup.mjs generates this local-only demo credential when it is empty.
DEMO_ADMIN_PASSWORD=
# The normal Compose invocation initializes this verified bundle into the named
# Docker volume mds01-vsvig-assets. This is the public hash of its contract.json,
# not a secret. Do not set a laptop filesystem path for browser uploads.
VSVIG_CONTRACT_SHA256=e55484a3c9d6eb6ef5559970eae5c6eab7a0c2d3d002340486676fc052512429
# For a registry-backed server, replace this local tag with an immutable image
# tag or digest in the server's private .env.
VIDEO_DETECTION_IMAGE=mds01-video-detection:local

# Required for deployment: use the hostname only, without https:// or a slash.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# Set the exact Cloudflare Access application audience in the private deployment environment.
CLOUDFLARE_ACCESS_AUD=
