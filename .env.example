# Copy to .env for local Docker development. Never commit real secrets.
# Run node scripts/setup.mjs to generate these values in .env.
POSTGRES_PASSWORD=
MDS01_STORAGE_KEY=replace-with-random-storage-key
MDS01_TEMPLATE_KEY=replace-with-random-template-key
MODEL_RUNTIME=stub
INSTALL_RESEARCH=false
SIGNAL_RETENTION_CONTEXT_SECONDS=600
UPLOAD_DRAFT_TTL_SECONDS=1800
ENABLE_SIGNAL_PREVIEW=false
ENABLE_FULL_SIGNAL_PREVIEW=false
FULL_SIGNAL_PREVIEW_MAX_SECONDS=7200
ENABLE_SHAP_EXPLANATIONS=false
SHAP_METADATA_BACKGROUND_PATH=/app/backend/model/shap-background-metadata.npy
SHAP_OBFUSCATED_BACKGROUND_PATH=/app/backend/model/shap-background-obfuscated.npy
SHAP_MAX_WINDOWS=3
SHAP_TIME_BINS=32
MAX_CONCURRENT_ANALYSES=1
MAX_VIDEO_UPLOAD_BYTES=536870912
VIDEO_RETENTION_SECONDS=86400
VIDEO_MAX_DURATION_SECONDS=3600
MDS01_MAX_ARCHIVE_TOTAL_BYTES=2147483648
MDS01_MAX_ZIP_COMPRESSION_RATIO=100

# Local development uses MDS01 accounts and Docker binds the API to loopback.
APP_ENV=development
AUTH_MODE=local-accounts
VIDEO_DETECTION_ENABLED=true
VSVIG_CONTRACT_SHA256=replace-with-reviewed-contract-sha256

# Required for deployment: use the hostname only, without https:// or a slash.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience
